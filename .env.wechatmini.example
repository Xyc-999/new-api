# WeChatMini integrated docker deployment example for new-api
#
# Usage:
#   cp .env.wechatmini.example .env.wechatmini
#   docker compose --env-file .env.wechatmini -f docker-compose.wechatmini.yml up -d --build

# Host port exposed by docker-compose.wechatmini.yml.
NEW_API_PORT=3000
# Container app port. Usually keep the default unless you also change the compose file.
PORT=3000
TZ=Asia/Shanghai
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=new-api
REDIS_PASSWORD=123456
SESSION_SECRET=session_8d2f6a94b71c4e0db9b5e3a7f62c9014
NODE_NAME=new-api-wechatmini-node-1

# Internal token shared by new-api WeChat settings and the wechat-login service.
# In the web admin panel, set:
#   WeChatAuthEnabled = true
#   WeChatServerAddress = http://wechat-login:8090
#   WeChatServerToken = this value
#   WeChatAccountQRCodeImageURL = https://your-domain.example/api/wechat/web/authorize
WECHAT_LOGIN_SERVER_TOKEN=4d8b9f3a7c2e6a1f0b5d9e3c8a6f2b7d1e9a4c0f6b3d8e2a

# Web WeChat login app.
# Keep these configured because the original web login also uses the second process.
WECHAT_WEB_APPID=your-web-wechat-appid
WECHAT_WEB_APP_SECRET=your-web-wechat-app-secret
# This public URL must route to the wechat-login container and be registered in
# WeChat Open Platform as the web OAuth callback.
WECHAT_WEB_CALLBACK_URL=https://your-domain.example/api/wechat/web/callback
# After WeChat returns code to wechat-login, redirect the browser back to New API.
WECHAT_WEB_FRONTEND_OAUTH_URL=https://your-domain.example/oauth?provider=wechat

# Mini-program login app.
WECHAT_MINI_APPID=wx1f5ac0e1c52851f9
WECHAT_MINI_APP_SECRET=f5de8c819995e5c17b035b84b9076dd8

# Enable WeChat Mini Program payment APIs.
# Keep this false before the recharge feature is ready for production.
WECHAT_MINI_PAY_ENABLED=false

# WeChat Pay API v3 (for future replacement of the current stub pay/create payload)
WECHAT_PAY_MCH_ID=your_mchid
WECHAT_PAY_MCH_SERIAL_NO=your_merchant_serial_no
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/wechatmini/pay/notify
WECHAT_PAY_API_V3_KEY=your_32_byte_v3_key
WECHAT_PAY_PLATFORM_CERT_PATH=/certs/wechat_platform_cert.pem
